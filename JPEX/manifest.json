{
  "manifest_version": 3,
  "name": "JP Dictionary Extension",
  "version": "3.0",
  "description": "Từ điển tiếng Nhật offline cao cấp tra cứu siêu tốc",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://jisho.org/*",
    "https://translate.googleapis.com/*",
    "https://hvdic.thivien.net/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "scripts/storage.js",
        "scripts/content_script.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
